# Native ROS 2 Jazzy, SLAM Toolbox, and Nav2 for Cubey.

[Unit]
Description=Cubey - Native ROS 2 Nav2 and SLAM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=__PROJECT_ROOT__/ros2
ExecStartPre=/usr/bin/rm -f /tmp/cubey_exploration_status.json /tmp/cubey_nav2_live_map.json /tmp/cubey_wheels_telemetry.txt
ExecStart=/bin/bash __PROJECT_ROOT__/ros2/run_nav.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
