# Gemini API Key (Get from Google AI Studio at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Live API (Default: gemini-2.5-flash-native-audio-latest)
# Options: gemini-2.5-flash-native-audio-latest, gemini-3.1-flash-live-preview
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest

# Preferred Voice (Options: Puck, Charon, Aoede, Fenrir, Kore)
GEMINI_VOICE=Puck

# Audio Settings
INPUT_SAMPLE_RATE=16000
OUTPUT_SAMPLE_RATE=24000
CHANNELS=1
# 20 ms microphone packets at 16 kHz. Increase only if your audio device
# reports underflows; lower values reduce latency but add callback overhead.
AUDIO_CHUNK_SIZE=320
AUDIO_INPUT_QUEUE_MS=240
AUDIO_OUTPUT_BLOCK_SIZE=240
# Log when Gemini is this far ahead of speaker playback; audio is preserved.
AUDIO_OUTPUT_BUFFER_MS=2000
# On Windows this selects the default WASAPI endpoints instead of ~90 ms MME.
AUDIO_PREFER_LOW_LATENCY_DEVICE=true
# Optional sounddevice device index or name overrides:
# For Raspberry Pi I2S (MAX98357A / INMP441):
# AUDIO_INPUT_DEVICE=plughw:2,0
# AUDIO_OUTPUT_DEVICE=plughw:2,0
# AUDIO_DEVICE_SAMPLE_RATE=48000
# AUDIO_DEVICE_CHANNELS=2
# AUDIO_DEVICE_DTYPE=int32

# Production noise suppression (RNNoise neural filter + HighPass motor rumble filter)
AUDIO_ENABLE_NOISE_SUPPRESSION=true

# Server voice-activity detection (lower silence = faster replies).
GEMINI_VAD_PREFIX_MS=150
GEMINI_VAD_SILENCE_MS=300

# Transient Gemini Live/WebSocket recovery. Resumable session context is kept.
GEMINI_RECONNECT_ATTEMPTS=5
GEMINI_RECONNECT_BASE_DELAY=0.5
GEMINI_RECONNECT_MAX_DELAY=5.0

# Database
# Optional override; defaults to <project root>/data/cubey.db if unset.
# DATABASE_URL=sqlite:///C:/absolute/path/to/cubey.db

# Local embeddings (fastembed) for semantic memory over past messages
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
